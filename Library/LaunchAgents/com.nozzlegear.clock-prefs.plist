<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nozzlegear.clock-prefs</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>defaults write com.apple.menuextra.clock ShowDate -bool true && defaults write com.apple.menuextra.clock ShowDayOfWeek -bool true</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>